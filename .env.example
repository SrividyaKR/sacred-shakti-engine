# Copy to .env and fill in. Never commit .env.

# Seedance 2.5 (default model) is routed to the first key that is set:
#   1. OpenRouter  -> bytedance/seedance-2.5
#   2. fal.ai      -> bytedance/seedance-2.5/image-to-video  (also used for Kling / MiniMax)
OPENROUTER_API_KEY=
FAL_KEY=

# Optional
ANTHROPIC_API_KEY=
